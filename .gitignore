/target

# Secrets: never commit tokens (cargo login writes ~/.cargo/credentials.toml,
# but a project-local .cargo/ folder could hold one too).
.cargo/credentials
.cargo/credentials.toml
.env
.env.*

# JavaScript
node_modules/
# The built web UI, compiled into ottie-api (pnpm --filter ui build)
/crates/api/ui-dist/

# Desktop app: the sidecar copied in by app/scripts/sidecar.mjs, and the
# schemas and command permissions tauri-build generates
/app/binaries/
/app/gen/
/app/permissions/autogenerated/
